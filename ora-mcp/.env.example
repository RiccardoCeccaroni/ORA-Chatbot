# ORA! MCP server — required credentials
# Copy to .env and fill in the real values for local development.
# In production (Fly.io), set these via `fly secrets set KEY=value`.

# Qdrant Cloud — read-only client for the ora_chunks collection
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=

# Voyage AI — embeddings (voyage-4-large) + reranker (rerank-2.5)
VOYAGE_API_KEY=

# Server bind (defaults shown)
HOST=0.0.0.0
PORT=8000

# Rate limit (requests per minute, per IP, for MCP tool calls)
RATE_LIMIT_PER_MINUTE=30

# OAuth — uses in-memory state (D33). No client_id/client_secret to configure;
# clients self-register dynamically via /register at runtime.
