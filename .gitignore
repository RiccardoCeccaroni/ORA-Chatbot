# Root-level ignores. Subdir-specific ignores live in chatbot/.gitignore
# and ora-mcp/.gitignore.

# Editor / OS
.obsidian/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Python (catch-all in case a venv lands at root)
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets / credentials (kept locally, never committed)
.env
.env.*

# AI-collaboration scaffolding (kept locally, not committed)
CLAUDE.md

# Local-only working folders (raw source material, YouTube ingest cache)
raw-materials/
Distill YT info/
